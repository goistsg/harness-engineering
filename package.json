{
  "name": "harness-engineering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Journal técnico sobre engenharia de software, liderança de squads e uso de IA em produção.",
  "homepage": "https://harnessengineering.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goistsg/harness-engineering.git"
  },
  "license": "MIT",
  "author": "Tiago Gois",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/harness-report.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint \"**/*.{js,mjs,ts,astro}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,ts,astro}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "harness-score",
    "quality:json": "harness-score --json",
    "quality:report": "harness-score --md quality-report.md",
    "lighthouse": "lhci autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "mermaid": "^11.16.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^16.0.0",
    "harness-score": "^1.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
