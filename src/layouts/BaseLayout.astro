---
import { getImage } from 'astro:assets';
import { SITE } from '@/config/site';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import logo from '@/assets/logo.png';
import '@/styles/global.css';

// A fonte principal é descoberta tarde, porque o @font-face vem de um CSS
// importado. Sem preload, o texto renderiza na fonte de fallback e reflui
// quando a Inter chega — o que aparece como layout shift. Importar o arquivo
// com `?url` devolve o caminho final com hash, gerado pelo próprio build.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Sobrescreve o canonical quando o conteúdo foi publicado antes em outro lugar. */
  canonical?: string | undefined;
  /** Injetado por ArticleLayout para acrescentar o JSON-LD do artigo. */
  ogType?: 'website' | 'article';
}

const { title, description, canonical, ogType = 'website' } = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title === SITE.title ? title : `${title} — ${SITE.name}`;

// O ícone de 180px do iOS sai do mesmo PNG de origem do logo, redimensionado
// pelo pipeline de imagem do build. Um arquivo derivado a menos para manter
// em sincronia à mão quando a marca mudar.
const appleTouchIcon = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#18181B" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — RSS`}
      href={new URL('/rss.xml', Astro.site).href}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#conteudo"
      class="bg-accent text-bg sr-only rounded px-4 py-2 font-medium focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      Pular para o conteúdo
    </a>

    <SiteHeader />

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
