---
interface Props {
  chart: string;
  caption?: string | undefined;
}

const { chart, caption } = Astro.props;
---

<figure class="my-8">
  <div
    class="mermaid-diagram border-border bg-surface overflow-x-auto rounded-lg border p-5"
    data-mermaid
  >
    {/* Fonte do diagrama: é o que aparece sem JavaScript e o que o script substitui. */}
    <pre class="text-fg-muted m-0 border-0 bg-transparent p-0 font-mono text-sm">{chart}</pre>
  </div>
  {caption && <figcaption class="text-fg-muted mt-3 text-center text-base">{caption}</figcaption>}
</figure>

<script>
  // Mermaid só é baixado quando um diagrama entra na viewport. Páginas sem
  // diagrama não pagam por ele; páginas com diagrama não bloqueiam o first paint.
  import type { Mermaid } from 'mermaid';

  const containers = document.querySelectorAll<HTMLElement>('[data-mermaid]');

  if (containers.length > 0) {
    let loader: Promise<Mermaid> | null = null;

    const loadMermaid = async () => {
      if (!loader) {
        loader = import('mermaid').then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            // 'base' é o único tema que respeita themeVariables por inteiro; o
            // tema 'dark' sobrescreve borda de nó e fundo de rótulo com a
            // própria paleta (#CCCCCC e #585858), que destoa do design system.
            theme: 'base',
            fontFamily: "'JetBrains Mono', ui-monospace, monospace",
            themeVariables: {
              darkMode: true,
              background: '#27272A',
              mainBkg: '#18181B',
              primaryColor: '#18181B',
              primaryTextColor: '#F4F4F5',
              primaryBorderColor: '#3F3F46',
              secondaryColor: '#27272A',
              secondaryBorderColor: '#3F3F46',
              tertiaryColor: '#27272A',
              tertiaryBorderColor: '#3F3F46',
              lineColor: '#A1A1AA',
              textColor: '#F4F4F5',
              nodeBorder: '#3F3F46',
              nodeTextColor: '#F4F4F5',
              edgeLabelBackground: '#27272A',
              clusterBkg: '#27272A',
              clusterBorder: '#3F3F46',
              titleColor: '#F4F4F5',
            },
          });
          return mermaid;
        });
      }
      return loader;
    };

    const render = async (container: HTMLElement, index: number) => {
      const source = container.querySelector('pre')?.textContent?.trim();
      if (!source) return;

      try {
        const mermaid = await loadMermaid();
        const { svg } = await mermaid.render(`mermaid-${index}`, source);
        container.innerHTML = svg;
      } catch {
        // Diagrama inválido mantém o código-fonte visível, que ainda comunica.
        container.dataset['mermaidError'] = 'true';
      }
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const container = entry.target as HTMLElement;
        observer.unobserve(container);
        void render(container, Array.from(containers).indexOf(container));
      }
    });

    containers.forEach((container) => observer.observe(container));
  }
</script>
