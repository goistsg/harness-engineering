---
interface Props {
  type?: 'note' | 'warning' | 'danger' | 'insight';
  title?: string | undefined;
}

const { type = 'note', title } = Astro.props;

const VARIANTS = {
  note: { label: 'Nota', accent: 'border-l-fg-muted' },
  warning: { label: 'Atenção', accent: 'border-l-accent' },
  danger: { label: 'Risco', accent: 'border-l-red-500' },
  insight: { label: 'Insight', accent: 'border-l-emerald-400' },
} as const;

const variant = VARIANTS[type];
---

<aside
  class:list={[
    'bg-surface border-border my-8 rounded-r-lg border border-l-4 px-5 py-4',
    variant.accent,
  ]}
>
  <p class="text-fg-muted mb-2 font-mono text-sm tracking-wide uppercase">
    {title ?? variant.label}
  </p>
  <div class="[&>*+*]:mt-3 [&>p]:m-0">
    <slot />
  </div>
</aside>
