---
import ArticleCard from './ArticleCard.astro';
import { groupByAxis, type Article } from '@/lib/journal';

interface Props {
  articles: readonly Article[];
}

const { articles } = Astro.props;
const groups = groupByAxis(articles);
---

{
  /* 3rem entre eixos: são grupos do mesmo tipo, um degrau abaixo da transição
    de 4rem que separa blocos diferentes da home. */
}
<div class="space-y-12">
  {
    groups.map(({ axis, articles: axisArticles }) => (
      <section aria-labelledby={`eixo-${axis.id}`}>
        <header class="max-w-2xl">
          <h2
            id={`eixo-${axis.id}`}
            class="text-accent font-mono text-sm tracking-widest uppercase"
          >
            {axis.label}
          </h2>
          <p class="text-fg-muted mt-2">{axis.description}</p>
        </header>

        <div class="mt-6">
          {axisArticles.length > 0 ? (
            axisArticles.map((article) => <ArticleCard article={article} />)
          ) : (
            /* O mesmo recuo negativo do card de artigo: sem ele, o filete do
               estado vazio fica 1rem mais estreito que o dos cards e as duas
               linhas não se alinham na mesma coluna. */
            <p class="border-border text-fg-muted -mx-4 border-t px-4 py-6 font-mono text-sm">
              Nenhum artigo publicado neste eixo ainda.
            </p>
          )}
        </div>
      </section>
    ))
  }
</div>
