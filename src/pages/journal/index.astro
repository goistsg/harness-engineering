---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JournalFeed from '@/components/JournalFeed.astro';
import { getPublishedArticles } from '@/lib/journal';

const articles = await getPublishedArticles();
---

<BaseLayout
  title="Journal"
  description="Todos os artigos do Harness Engineering, organizados por eixo temático: liderança e squads, IA na prática, arquitetura e segurança."
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <header class="max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Journal</h1>
      <p class="text-fg-muted mt-4 text-xl">
        {articles.length}
        {articles.length === 1 ? 'artigo publicado' : 'artigos publicados'}, organizados por eixo
        temático.
      </p>
    </header>

    <div class="mt-14">
      <JournalFeed articles={articles} />
    </div>
  </div>
</BaseLayout>
